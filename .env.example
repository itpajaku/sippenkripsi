# Port HTTP yang akan dibuka pada host (default: 8080)
PORT=8080

# Kunci enkripsi default dari SIPP (application/config/config.php -> $config['encryption_key'])
# Jika diisi di sini, pemanggil API tidak wajib menyertakan field "key" di request JSON
SIPP_ENCRYPTION_KEY=your_sipp_encryption_key_here

# (Opsional) API Key untuk mengamankan endpoint
# Jika diisi, client harus mengirimkan header 'X-API-Key: <nilai>' atau 'Authorization: Bearer <nilai>'
# Kosongkan jika API bersifat open/internal network tanpa auth
API_KEY=
